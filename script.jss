```css
body{
margin:0;
font-family:Arial;
background:#f4f4f4;
}

/* HERO */

.hero{
display:flex;
align-items:center;
justify-content:space-between;
padding:60px;
background:#ffffff;
}

.hero-text h1{
font-size:40px;
}

.hero-text p{
font-size:20px;
}

.btn{
background:#ff9800;
color:white;
padding:10px 20px;
text-decoration:none;
border-radius:5px;
}

.hero-img img{
width:350px;
border-radius:10px;
box-shadow:0 0 20px rgba(0,0,0,0.3);
}


/* SECTION COMMON */

section{
padding:40px;
margin:30px;
background:white;
border-radius:10px;
box-shadow:0 0 10px rgba(0,0,0,0.1);
}


/* SKILLS */

.box{
background:#f7f7f7;
padding:15px;
margin:10px 0;
border-left:5px solid orange;
}


/* PROJECTS */

.project{
background:#f7f7f7;
padding:15px;
margin:10px 0;
border-left:5px solid green;
}


/* CONTACT */

.contact p{
font-size:18px;
}


/* FOOTER */

footer{
background:black;
color:white;
text-align:center;
padding:15px;
}
```

